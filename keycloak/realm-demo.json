      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo.user@example.com",
      "realmRoles": ["user"],
      "credentials": [
        {
          "type": "password",
          "value": "123123",
          "temporary": false
        }
      ]
    },
